Accept-Language: {{locale}}

# Module: shipping

### Calculate shipping rates
POST {{baseUrl}}/v1/shipping/rates
Accept-Language: {{locale}}
Content-Type: application/json

{
  "country": "country",
  "postalCode": "postalCode",
  "items": [
    {
      "weight": 1,
      "quantity": 1
    }
  ],
  "subtotal": 1
}

# Module: store

### The runtime store config: identity, brand, localization, money, domains
GET {{baseUrl}}/v1/store/config
Accept-Language: {{locale}}

# Module: storefront

### Get the public store identity, currency, locales, stock threshold and pixels
GET {{baseUrl}}/v1/storefront/config
Accept-Language: {{locale}}

### DEPRECATED: Get homepage hero + mid-banner config
GET {{baseUrl}}/v1/storefront/home-banners
Accept-Language: {{locale}}

### Get visible storefront sections for a page (Translatable resolved, asset URLs hydrated)
GET {{baseUrl}}/v1/storefront/sections/{{pageSlug}}
Accept-Language: {{locale}}

# Module: unsubscribe

### Unsubscribe via the email footer link
GET {{baseUrl}}/v1/unsubscribe?token=token&locale=locale
Accept-Language: {{locale}}

### One-click unsubscribe (RFC 8058)
POST {{baseUrl}}/v1/unsubscribe?token=token
Accept-Language: {{locale}}

# Module: users

### Get current user profile
GET {{baseUrl}}/v1/users/me
Accept-Language: {{locale}}

### Update user profile
PATCH {{baseUrl}}/v1/users/me
Accept-Language: {{locale}}
Content-Type: application/json

{
  "firstName": "firstName",
  "lastName": "lastName",
  "email": "email",
  "phone": "phone",
  "avatarUrl": "avatarUrl",
  "currentPassword": "currentPassword",
  "newPassword": "newPassword",
  "locale": "locale"
}

### Create new address
POST {{baseUrl}}/v1/users/me/addresses
Accept-Language: {{locale}}
Content-Type: application/json

{
  "label": "label",
  "fullName": "fullName",
  "phone": "phone",
  "addressLine1": "addressLine1",
  "addressLine2": "addressLine2",
  "city": "city",
  "state": "state",
  "postalCode": "postalCode",
  "country": "country",
  "isDefaultShipping": true,
  "isDefaultBilling": true
}

### Delete address
DELETE {{baseUrl}}/v1/users/me/addresses/{{addressId}}
Accept-Language: {{locale}}

### Update address
PATCH {{baseUrl}}/v1/users/me/addresses/{{addressId}}
Accept-Language: {{locale}}
Content-Type: application/json

{
  "label": "label",
  "fullName": "fullName",
  "phone": "phone",
  "addressLine1": "addressLine1",
  "addressLine2": "addressLine2",
  "city": "city",
  "state": "state",
  "postalCode": "postalCode",
  "country": "country",
  "isDefaultShipping": true,
  "isDefaultBilling": true
}

### Set address as default
PATCH {{baseUrl}}/v1/users/me/addresses/{{addressId}}/default
Accept-Language: {{locale}}
Content-Type: application/json

{
  "isDefaultShipping": true,
  "isDefaultBilling": true
}

### Get the current customer notification-consent map
GET {{baseUrl}}/v1/users/me/notification-preferences
Accept-Language: {{locale}}

### Update the current customer notification-consent map
PATCH {{baseUrl}}/v1/users/me/notification-preferences
Accept-Language: {{locale}}
Content-Type: application/json

{
  "LIFECYCLE": {
    "email": true,
    "sms": true,
    "push": true
  },
  "MARKETING": {
    "email": true,
    "sms": true,
    "push": true
  }
}

# Module: wishlist

### Get wishlist
GET {{baseUrl}}/v1/wishlist
Accept-Language: {{locale}}

### Remove item from wishlist
DELETE {{baseUrl}}/v1/wishlist/{{productId}}
Accept-Language: {{locale}}

### Add item to wishlist
POST {{baseUrl}}/v1/wishlist/{{productId}}
Accept-Language: {{locale}}

### Get wishlisted product ids
GET {{baseUrl}}/v1/wishlist/ids
Accept-Language: {{locale}}
