# generated by npm run docs:generate; do not edit
# Every storefront operation of the OpenAPI document, one request each, in the order of the reference pages. Open it with the REST Client extension of VS Code or with IntelliJ; the cookie jar keeps the session after Sign in.
@baseUrl = https://api.shop.example/api
@locale = en
@addressId = addressId
@id = id
@itemId = itemId
@orderId = orderId
@pageSlug = pageSlug
@productId = productId
@slug = slug

# These four requests come from the authentication handler (Better Auth, mounted at /v1/auth) and not from the OpenAPI document. Sign in sets the session cookie and the cookie jar sends it on every later request; the admin signs in through the same handler with a staff account.

### Sign up
POST {{baseUrl}}/v1/auth/sign-up/email
Accept-Language: {{locale}}
Content-Type: application/json

{
  "email": "customer@shop.example",
  "password": "a-strong-password",
  "name": "Ada Lovelace",
  "firstName": "Ada",
  "lastName": "Lovelace"
}

### Sign in
POST {{baseUrl}}/v1/auth/sign-in/email
Accept-Language: {{locale}}
Content-Type: application/json

{
  "email": "customer@shop.example",
  "password": "a-strong-password"
}

### Get session
GET {{baseUrl}}/v1/auth/get-session
Accept-Language: {{locale}}

### Sign out
POST {{baseUrl}}/v1/auth/sign-out
Accept-Language: {{locale}}

# Module: analytics

### Ingest a storefront analytics event
POST {{baseUrl}}/v1/analytics/events
Accept-Language: {{locale}}
Content-Type: application/json

{
  "eventType": {},
  "sessionId": "sessionId",
  "userId": "userId",
  "productId": "productId",
  "orderId": "orderId",
  "data": {},
  "locale": "locale"
}

# Module: cart

### Clear shopping cart
DELETE {{baseUrl}}/v1/cart
Accept-Language: {{locale}}

### Get shopping cart
GET {{baseUrl}}/v1/cart
Accept-Language: {{locale}}

### Remove coupon from cart
DELETE {{baseUrl}}/v1/cart/coupon
Accept-Language: {{locale}}

### Apply coupon code
POST {{baseUrl}}/v1/cart/coupon
Accept-Language: {{locale}}
Content-Type: application/json

{
  "code": "code"
}

### Estimate shipping cost
GET {{baseUrl}}/v1/cart/estimate?country=country
Accept-Language: {{locale}}

### Remove gift card from cart
DELETE {{baseUrl}}/v1/cart/gift-card
Accept-Language: {{locale}}

### Apply gift card
POST {{baseUrl}}/v1/cart/gift-card
Accept-Language: {{locale}}
Content-Type: application/json

{
  "code": "code"
}

### Add item to cart
POST {{baseUrl}}/v1/cart/items
Accept-Language: {{locale}}
Content-Type: application/json

{
  "variantId": "variantId",
  "quantity": 1
}

### Remove cart item
DELETE {{baseUrl}}/v1/cart/items/{{itemId}}
Accept-Language: {{locale}}

### Update cart item
PATCH {{baseUrl}}/v1/cart/items/{{itemId}}
Accept-Language: {{locale}}
Content-Type: application/json

{
  "quantity": 1
}

### Save item for later
POST {{baseUrl}}/v1/cart/items/{{itemId}}/save-for-later
Accept-Language: {{locale}}

### Merge the anonymous cart into the signed-in cart
POST {{baseUrl}}/v1/cart/merge
Accept-Language: {{locale}}

# Module: categories

### Get category tree
GET {{baseUrl}}/v1/categories
Accept-Language: {{locale}}

### Get category by slug
GET {{baseUrl}}/v1/categories/{{slug}}
Accept-Language: {{locale}}

### Get products in category
GET {{baseUrl}}/v1/categories/{{slug}}/products?page=page&pageSize=pageSize
Accept-Language: {{locale}}

# Module: checkout

### Get the public checkout settings and the enabled payment methods
GET {{baseUrl}}/v1/checkout/settings
Accept-Language: {{locale}}

# Module: contact

### Submit a contact-form message
POST {{baseUrl}}/v1/contact
Accept-Language: {{locale}}
Content-Type: application/json

{
  "fromName": "fromName",
  "fromEmail": "fromEmail",
  "subjectLine": "subjectLine",
  "message": "message"
}

# Module: gift-cards

### Check gift card balance
GET {{baseUrl}}/v1/gift-cards/balance?code=code
Accept-Language: {{locale}}

# Module: health

### Health check
GET {{baseUrl}}/health
Accept-Language: {{locale}}

### Runtime identity (env, and the database name in test mode)
GET {{baseUrl}}/v1/health/identity
Accept-Language: {{locale}}

# Module: newsletter

### Confirm a newsletter subscription
GET {{baseUrl}}/v1/newsletter/confirm?token=token&locale=locale
Accept-Language: {{locale}}

### Subscribe to the newsletter (double opt-in)
POST {{baseUrl}}/v1/newsletter/subscribe
Accept-Language: {{locale}}
Content-Type: application/json

{
  "locale": "locale",
  "email": "email"
}

### Unsubscribe via the email footer link
GET {{baseUrl}}/v1/newsletter/unsubscribe?token=token&locale=locale
Accept-Language: {{locale}}

### One-click newsletter unsubscribe (RFC 8058)
POST {{baseUrl}}/v1/newsletter/unsubscribe?token=token
Accept-Language: {{locale}}

# Module: orders

### List orders
GET {{baseUrl}}/v1/orders
Accept-Language: {{locale}}

### Create order (authenticated customer or guest)
POST {{baseUrl}}/v1/orders
Accept-Language: {{locale}}
Content-Type: application/json
X-Idempotency-Key: {{$guid}}

{
  "guestEmail": "guestEmail",
  "shippingAddressId": "shippingAddressId",
  "shippingAddress": {
    "fullName": "fullName",
    "phone": "phone",
    "addressLine1": "addressLine1",
    "addressLine2": "addressLine2",
    "city": "city",
    "state": "state",
    "postalCode": "postalCode",
    "country": "country"
  },
  "billingAddressId": "billingAddressId",
  "billingAddress": {
    "fullName": "fullName",
    "phone": "phone",
    "addressLine1": "addressLine1",
    "addressLine2": "addressLine2",
    "city": "city",
    "state": "state",
    "postalCode": "postalCode",
    "country": "country"
  },
  "shippingMethodId": "shippingMethodId",
  "paymentMethodCode": "paymentMethodCode",
  "notes": "notes",
  "giftCardCode": "giftCardCode",
  "couponCode": "couponCode"
}

### Get order by ID (owner or the guest who placed it)
GET {{baseUrl}}/v1/orders/{{id}}
Accept-Language: {{locale}}

### Cancel order
POST {{baseUrl}}/v1/orders/{{id}}/cancel
Accept-Language: {{locale}}

### Get order invoice
GET {{baseUrl}}/v1/orders/{{id}}/invoice
Accept-Language: {{locale}}

### Download order invoice as a branded PDF
GET {{baseUrl}}/v1/orders/{{id}}/invoice/pdf
Accept-Language: {{locale}}

### Create return request
POST {{baseUrl}}/v1/orders/{{orderId}}/returns
Accept-Language: {{locale}}
Content-Type: application/json

{
  "items": [
    {
      "orderItemId": "orderItemId",
      "quantity": 1,
      "exchangeVariantId": "exchangeVariantId"
    }
  ],
  "reason": {},
  "reasonDetail": "reasonDetail",
  "photoAssetIds": [
    "photoAssetIds"
  ],
  "refundMethod": {}
}

### Track an order by number and email
POST {{baseUrl}}/v1/orders/track
Accept-Language: {{locale}}
Content-Type: application/json

{
  "orderNumber": "orderNumber",
  "email": "email"
}

# Module: pages

### List published CMS pages
GET {{baseUrl}}/v1/pages
Accept-Language: {{locale}}

### Get a published CMS page by slug
GET {{baseUrl}}/v1/pages/{{slug}}
Accept-Language: {{locale}}

# Module: products

### List active products
GET {{baseUrl}}/v1/products
Accept-Language: {{locale}}

### Get product by slug
GET {{baseUrl}}/v1/products/{{slug}}
Accept-Language: {{locale}}

### List product questions
GET {{baseUrl}}/v1/products/{{slug}}/questions
Accept-Language: {{locale}}

### Create product question
POST {{baseUrl}}/v1/products/{{slug}}/questions
Accept-Language: {{locale}}
Content-Type: application/json

{
  "question": "question"
}

### List product reviews
GET {{baseUrl}}/v1/products/{{slug}}/reviews
Accept-Language: {{locale}}

### Create product review
POST {{baseUrl}}/v1/products/{{slug}}/reviews
Accept-Language: {{locale}}
Content-Type: application/json

{
  "rating": 1,
  "title": "title",
  "body": "body",
  "assetIds": [
    "assetIds"
  ]
}

### Whether the caller may review this product
GET {{baseUrl}}/v1/products/{{slug}}/reviews/eligibility
Accept-Language: {{locale}}

### Get the caller's own review for a product
GET {{baseUrl}}/v1/products/{{slug}}/reviews/mine
Accept-Language: {{locale}}

### Get review summary
GET {{baseUrl}}/v1/products/{{slug}}/reviews/summary
Accept-Language: {{locale}}

### List brand facets for the catalogue
GET {{baseUrl}}/v1/products/brands
Accept-Language: {{locale}}

### List filterable specification facets
GET {{baseUrl}}/v1/products/spec-facets
Accept-Language: {{locale}}

# Module: promotions

### Get automatic promotions
POST {{baseUrl}}/v1/promotions/automatic
Accept-Language: {{locale}}
Content-Type: application/json

{
  "subtotal": 1,
  "items": [
    {
      "productId": "productId",
      "categoryId": "categoryId",
      "quantity": 1,
      "unitPrice": 1
    }
  ],
  "userId": "userId"
}

### Validate coupon code
POST {{baseUrl}}/v1/promotions/validate-coupon
Accept-Language: {{locale}}
Content-Type: application/json

{
  "code": "code",
  "subtotal": 1,
  "items": [
    {
      "productId": "productId",
      "categoryId": "categoryId",
      "quantity": 1,
      "unitPrice": 1
    }
  ],
  "userId": "userId"
}

