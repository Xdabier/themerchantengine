Accept-Language: {{locale}}

# Module: reviews

### Delete review
DELETE {{baseUrl}}/v1/reviews/{{id}}
Accept-Language: {{locale}}

### Update review
PATCH {{baseUrl}}/v1/reviews/{{id}}
Accept-Language: {{locale}}
Content-Type: application/json

{
  "rating": 1,
  "title": "title",
  "body": "body",
  "assetIds": [
    "assetIds"
  ]
}

### Mark review as helpful
POST {{baseUrl}}/v1/reviews/{{id}}/helpful
Accept-Language: {{locale}}

# Module: search

### Search products
GET {{baseUrl}}/v1/search
Accept-Language: {{locale}}

### Log product click
POST {{baseUrl}}/v1/search/events/{{id}}/click
Accept-Language: {{locale}}
Content-Type: application/json

{
  "clickedProductId": "clickedProductId",
  "clickPosition": 1
}

### Log product conversion
POST {{baseUrl}}/v1/search/events/{{id}}/convert
Accept-Language: {{locale}}

### Get search filters
GET {{baseUrl}}/v1/search/filters?q=q
Accept-Language: {{locale}}

### Get search suggestions
GET {{baseUrl}}/v1/search/suggest?q=q
Accept-Language: {{locale}}

