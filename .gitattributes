# Deploy scripts and systemd units execute on the Linux prod boxes. A CRLF
# checkout breaks the shebang with `bad interpreter: /usr/bin/env bash^M`, so
# pin them to LF regardless of the committer's core.autocrlf setting.
deploy/**/*.sh              text eol=lf
apps/*/docker/*.sh          text eol=lf
deploy/shared/systemd/**    text eol=lf
scripts/ci/*.sh             text eol=lf
setup.sh                    text eol=lf

# What `git archive` leaves out of the release tarball (scripts/release.mjs).
# The tree also carries the project's own planning record, its security
# audits, its agent configuration and instructions, the path of a retired
# test private key (so a key put back by hand stays out), the gitleaks
# fingerprint list (it names files and lines of past findings), its research
# and marketing notes, a third-party PDF, and the specs that read the agent
# configuration or the client token table, none of which is part of the
# product.
# scripts/__tests__/release.spec.ts pins this list against the real archive.
# The PDF name has spaces, hence the glob. A pattern without a slash matches
# at any depth, so root directories are anchored with a leading `/`.
/specs/                                 export-ignore
/.claude/                               export-ignore
/.session-runner/                       export-ignore
docs/audit/                             export-ignore
docs/security-audit-report.md           export-ignore
docs/security-research.md               export-ignore
docs/admin-manual-qa-findings.md        export-ignore
docs/storefront-manual-qa-findings*.md  export-ignore
