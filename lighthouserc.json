{
  "ci": {
    "collect": {
      "staticDistDir": "dist/apps/admin/browser",
      "isSinglePageApplication": true,
      "url": [
        "http://localhost/auth/login",
        "http://localhost/auth/forgot",
        "http://localhost/403",
        "http://localhost/404"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.5
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
