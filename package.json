{
  "name": "themerchantengine",
  "version": "1.0.1",
  "description": "themerchantengine: one generic e-commerce engine (NestJS API, Angular admin, Analog.js storefront) configured at install time",
  "author": "Badii Studio",
  "homepage": "https://themerchantengine.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xdabier/themerchantengine.git"
  },
  "bugs": {
    "url": "https://github.com/Xdabier/themerchantengine/issues"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nx build api",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "nx serve api",
    "start:dev": "nx serve api",
    "start:prod": "node dist/apps/api/main.js",
    "lint": "nx run api:lint && nx run common:eslint:lint",
    "test": "nx run-many -t test --parallel=2",
    "test:cov": "nx run-many -t test --coverage --parallel=2",
    "test:e2e": "nx e2e api --forceExit",
    "test:services-e2e": "nx e2e admin-services-e2e",
    "test:storefront-ssr-smoke": "nx run storefront:verify-ssr-smoke",
    "affected:test": "nx affected -t test",
    "guards": "nx run guards:test",
    "t": "node scripts/test-quiet.mjs test",
    "t:e2e": "node scripts/test-quiet.mjs e2e",
    "e2e:serve": "node apps/admin-e2e/serve-admin-e2e.mjs",
    "gate": "nx run guards:test && nx affected -t lint eslint:lint test --parallel=3 && npm run test:scripts",
    "gate:e2e": "nx e2e admin-e2e --grep \"journey|baseline\" && nx e2e storefront-e2e",
    "gate:coverage": "nx run-many -t test --projects=api,admin,admin-ui,admin-services,admin-types,admin-routes --coverage --parallel=2",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint eslint:lint",
    "graph": "nx graph",
    "build:admin": "nx build admin",
    "lhci": "lhci autorun",
    "lhci:collect": "lhci collect",
    "lhci:assert": "lhci assert",
    "lighthouse:home": "node scripts/lighthouse-storefront.mjs home",
    "lighthouse:product": "node scripts/lighthouse-storefront.mjs product",
    "lighthouse:all": "node scripts/lighthouse-storefront.mjs all",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status --verbose",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:push:raw": "prisma db push",
    "db:push": "npm run db:push:raw && npm run db:fts && npm run db:order-status-history",
    "db:flush-cache": "ts-node prisma/flush-money-cache.ts",
    "db:fts": "ts-node prisma/apply-fts-setup.ts",
    "db:fts:generate": "ts-node prisma/generate-fts-setup.ts",
    "db:notification-indexes": "ts-node prisma/apply-notification-indexes.ts",
    "db:order-status-history": "ts-node prisma/backfill-order-status-history.ts",
    "db:backfill-templates": "ts-node prisma/backfill-notification-bodies.ts",
    "db:variant-labels": "ts-node prisma/backfill-variant-labels.ts",
    "db:setup": "npm run db:push:raw -- --accept-data-loss && npm run db:fts && npm run db:notification-indexes && npm run db:order-status-history && npm run prisma:generate",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:seed:fixture-catalogue": "ts-node prisma/seeds/fixture-catalogue/cli.ts",
    "db:seed:fixture-catalogue:test": "ts-node scripts/seed-storefront-test.ts",
    "test:fixture-catalogue-seed": "vitest run --config prisma/seeds/fixture-catalogue/vitest.config.ts",
    "test:store-config-seed": "vitest run --config prisma/seeds/store-config/vitest.config.ts",
    "test:notification-defaults": "vitest run --config prisma/vitest.config.ts",
    "test:setup": "vitest run --config tools/setup/vitest.config.ts",
    "build:setup": "node tools/setup/build.mjs",
    "typecheck:setup": "tsc -p tools/setup/tsconfig.json --noEmit",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "llm:metrics": "python scripts/llm-metrics/baseline.py",
    "lint:instructions": "node scripts/llm-metrics/lint-instructions.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "verify:no-client-refs": "ts-node --transpile-only scripts/verify-no-client-refs.ts",
    "release": "node scripts/release.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "docs:generate": "nx build api && ts-node --transpile-only scripts/docs-generate.ts",
    "docs:generate:check": "nx build api && ts-node --transpile-only scripts/docs-generate.ts --check",
    "docs:walkthrough": "ts-node --transpile-only scripts/storefront-walkthrough.ts",
    "docs:staleness": "ts-node --transpile-only scripts/docs-staleness.ts",
    "fingerprint:check": "ts-node --transpile-only scripts/fingerprint-check.ts"
  },
  "overrides": {
    "multer": "^2.2.0"
  },
  "dependencies": {
    "@analogjs/content": "^2.9.5",
    "@analogjs/router": "^2.9.5",
    "@angular/cdk": "~22.2.5",
