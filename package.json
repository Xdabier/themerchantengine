    "@angular/platform-server": "~22.2.4",
    "@changesets/cli": "^2.30.0",
    "@lhci/cli": "^0.15.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@nx/angular": "^24.0.3",
    "@nx/devkit": "24.0.3",
