    "@angular/platform-browser-dynamic": "~22.2.4",
    "@angular/router": "~22.2.4",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1040.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@noble/hashes": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/angular": "^10.49.0",
    "@sentry/node": "^10.49.0",
    "@tanstack/angular-query-experimental": "^5.99.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "bcrypt": "^5.1.0",
    "better-auth": "^1.6.11",
    "blurhash": "^2.0.5",
    "bullmq": "^4.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "16.4.5",
    "express": "^4.22.1",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^171.4.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-angular": "^1.0.0",
    "nestjs-pino": "^3.4.0",
    "pdfkit": "^0.19.1",
    "pino": "^8.15.0",
    "pino-http": "^8.4.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "rxjs": "~7.8.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.33.5",
    "stripe": "^23.0.0",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^9.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.5",
