{
  "name": "admin-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/admin-ui/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:admin", "type:ui"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "jest -c libs/admin-ui/jest.config.cts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/admin-ui"
      }
    }
  }
}
