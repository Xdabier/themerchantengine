{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["apps/api/src/*"],
      "@modules/*": ["apps/api/src/modules/*"],
      "@common/*": ["libs/shared/common/src/*"],
      "@config/*": ["apps/api/src/config/*"],
      "@merchants/shared-common": ["libs/shared/common/src/index.ts"],
      "@admin-routes": ["libs/shared/admin-routes/src/index.ts"],
      "@permissions": ["libs/shared/permissions/src/index.ts"],
      "@admin/*": ["apps/admin/src/*"],
      "@admin-ui/*": ["libs/admin-ui/src/*"],
      "@admin-services/*": ["libs/admin-services/src/*"],
      "@admin-types/*": ["libs/admin-types/src/*"],
      "@admin-types": ["libs/admin-types/src/index.ts"],
      "@admin-ui": ["libs/admin-ui/src/index.ts"],
      "@admin-services": ["libs/admin-services/src/index.ts"],
      "@storefront-types/*": ["libs/storefront-types/src/*"],
      "@storefront-types": ["libs/storefront-types/src/index.ts"],
      "@storefront-services/*": ["libs/storefront-services/src/*"],
      "@storefront-services": ["libs/storefront-services/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
