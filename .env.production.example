# The engine's production environment, as the install stepper writes it.
#
# Nothing here is meant to be edited by hand: `./setup.sh` asks
# every value once, verifies the third-party ones live, and writes
# `.env.production` with every value quoted and mode 0600. This example shows
# the keys and the shape so an operator can read a deployment; to change a
# value, run setup again. The hosts and secrets below are placeholders.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="53000"
API_GLOBAL_PREFIX="api"
LOG_LEVEL="info"

# ── Database and cache (compose service names) ─────────────────────────────
DB_PASSWORD="<generated, 64 hex>"
DATABASE_URL="postgresql://merchants_app:<generated>@postgres:5432/merchants_engine?schema=public"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD="<generated, 64 hex>"

# ── Auth and origins ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET="<generated, 64 hex>"
# The public API origin, used in every callback link inside an email.
BETTER_AUTH_URL="https://api.shop.example"
# Also Better Auth trustedOrigins. The admin reaches the API through its own origin.
CORS_ORIGIN="https://shop.example,https://admin.shop.example"
STOREFRONT_PUBLIC_BASE_URL="https://shop.example"
ADMIN_PUBLIC_BASE_URL="https://admin.shop.example"
API_PUBLIC_BASE_URL="https://api.shop.example"
STOREFRONT_REVALIDATE_URL="https://shop.example/api/_internal/revalidate"
STOREFRONT_REVALIDATE_SECRET="<generated, 64 hex; the storefront box needs the same value>"
UNSUBSCRIBE_TOKEN_SECRET="<generated, 64 hex>"
TURNSTILE_SECRET="<entered and verified against siteverify>"

# ── Uploads and asset storage ──────────────────────────────────────────────
MAX_FILE_SIZE="10485760"
ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,pdf,doc,docx"
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://s3.<region>.example"
S3_REGION="<region>"
S3_BUCKET="<bucket, hyphens, no dots>"
S3_ACCESS_KEY="<entered and verified by a put, get and delete>"
S3_SECRET_KEY="<entered>"
S3_PUBLIC_URL="https://<bucket>.s3.<region>.example"
SIGNED_URL_SECRET="<generated, 64 hex>"
RETAIN_ORIGINALS="false"
INVOICE_LOGO_PATH="/app/config/invoice-logo.png"

# ── Mail ───────────────────────────────────────────────────────────────────
MAIL_TRANSPORT="resend"
RESEND_API_KEY="<entered and verified by a domain lookup and a test message>"
RESEND_WEBHOOK_SECRET="<entered>"
RESEND_FROM_EMAIL="noreply@shop.example"
RESEND_FROM_NAME="My Store"
RESEND_REPLY_TO="hello@shop.example"
CONTACT_FORM_RECIPIENT="hello@shop.example"
# Honoured under NODE_ENV=development only; a production boot refuses a non-empty value.
MAIL_DEV_REDIRECT_TO=""

# ── Search-engine submission ───────────────────────────────────────────────
INDEXNOW_KEY=""
BING_API_KEY=""
BING_SITE_URL=""
GSC_SUBMISSION_ENABLED="false"
GSC_SITE_URL=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ── Payments ───────────────────────────────────────────────────────────────
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
