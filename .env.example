# Development environment for `nx serve api` (copy to .env).
#
# A deployment never edits a file like this by hand: the install stepper
# (`./setup.sh`) writes `.env.production` from its answers, every
# value quoted, nothing left to fill in. This file is the developer's copy for
# a laptop that runs the API against the docker-compose dev services.

# Server
PORT=53000
# development and test are the only labels that unlock a development
# behaviour; every other label, and none, reads as production.
NODE_ENV=development
# Path prefix for every API route. The admin dev proxy forwards /api unchanged
# and the storefront one prefixes /v1 with /api, so dev uses `api` too; the e2e
# harnesses set their own.
API_GLOBAL_PREFIX=api

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/merchants_engine_dev
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:55433/merchants_engine_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_TEST_HOST=localhost
REDIS_TEST_PORT=56380
# Set both for a managed Redis; TLS is opt-in with `true`.
# REDIS_PASSWORD=
# REDIS_TLS=true

# Better Auth owns auth and sessions.
# BETTER_AUTH_SECRET is high-entropy, >= 32 bytes; rotate it when a person who knew it leaves.
BETTER_AUTH_SECRET=change-in-production-min-32-bytes-abcde
# The API's own externally-reachable base URL (used to build email links).
BETTER_AUTH_URL=http://localhost:53000
# Cross-subdomain session cookie, production only. Leading-dot root domain so
# the session is shared across the admin / storefront / api subdomains. The
# stepper leaves it unset: every install proxies /api on the admin host.
# AUTH_COOKIE_DOMAIN=.shop.example
# `1` lets a new account sign in before it verifies its email. Local and e2e
# use only. Never set it in production: the API does not refuse it there.
# AUTH_SKIP_EMAIL_VERIFICATION=1

# Logging
LOG_LEVEL=debug
# Error reporting. Unset, Sentry stays off.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS - admin dev (53200), admin e2e (53211), storefront dev (53300), storefront e2e (53311).
CORS_ORIGIN=http://localhost:53200,http://localhost:53211,http://localhost:53300,http://localhost:53311

# Public origins. In dev these are the local servers; the stepper writes the
# deployed origins, and the API refuses to boot in production without them.
STOREFRONT_PUBLIC_BASE_URL=http://localhost:53300
ADMIN_PUBLIC_BASE_URL=http://localhost:53200
API_PUBLIC_BASE_URL=http://localhost:53000

# Storefront revalidation - backend-to-backend signal that triggers SSR cache
# invalidation on product / category / CMS write events. Both values must match
# the storefront's. The secret is a high-entropy string ≥ 32 bytes. Never log it.
STOREFRONT_REVALIDATE_URL=http://localhost:53300/api/_internal/revalidate
STOREFRONT_REVALIDATE_SECRET=change-in-production-min-32-bytes-12345
# Legacy fallback for the storefront origin in search-engine pings; read only
# when STOREFRONT_PUBLIC_BASE_URL is unset.
# STOREFRONT_REVALIDATE_URL_BASE=http://localhost:53300

# Storefront server. The base URL its SSR calls reach the API on.
STOREFRONT_API_URL=http://localhost:53000/api

# Storefront facets. A facet shows once at least this many products carry it,
# and only while distinct values divided by covered products stays at or under
# the spread.
# STOREFRONT_MIN_FACET_COVERAGE=6
# STOREFRONT_MAX_FACET_SPREAD=0.35

# Rate limiting. Off under NODE_ENV=test unless ENABLE_THROTTLE is set.
# Setting DISABLE_THROTTLE to 1 turns it off outside production only.
# ENABLE_THROTTLE=1
# DISABLE_THROTTLE=1

# Technology detectors. The engine names itself in a generator meta tag and
# an X-Powered-By header. off, false, 0 or no removes every marker; major
# adds the major version. The full version is never sent.
# TME_FINGERPRINT=off
# TME_FINGERPRINT_VERSION=major

# Unsubscribe links in outbound mail are signed with this.
UNSUBSCRIBE_TOKEN_SECRET=change-in-production-min-32-bytes-abcdef

# File Upload
# Public-served uploads root, relative to the working directory.
UPLOADS_ROOT=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Asset storage - choose driver per environment.
#   local - writes to ./uploads (dev fallback, no S3 needed)
#   s3    - any S3-compatible bucket (set the S3_* vars below)
STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.<region>.example
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=

# Asset variant pipeline.
# Local driver - where uploaded originals are written. Must be OUTSIDE the
# public-served `uploads/` root. Defaults to `./uploads-private/`.
PRIVATE_UPLOADS_DIR=./uploads-private
# Secret used by `LocalStorageDriver.signUrl()` to mint HMAC-signed admin
# access URLs for private originals. High-entropy ≥ 32 bytes.
SIGNED_URL_SECRET=change-in-production-min-32-bytes-67890
# Original-deletion gate: true keeps originals for re-processing (dev), false
# deletes them once every variant is verified (the production default).
RETAIN_ORIGINALS=true

# Payments
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
# Transport selection - `console` (default, no network) lets local dev + jest +
# e2e run without a Resend account. `resend` calls the real API.
MAIL_TRANSPORT=console
# Sending-only API key (re_…). REQUIRED when MAIL_TRANSPORT=resend.
RESEND_API_KEY=
# Envelope-from address. Must be on a Resend-verified domain.
RESEND_FROM_EMAIL=noreply@example.test
# Display name combined with RESEND_FROM_EMAIL to build the From: header.
RESEND_FROM_NAME=My Store
# Default Reply-To header. Per-job overrides take precedence.
RESEND_REPLY_TO=contact@example.test
# Where the storefront contact form is delivered.
CONTACT_FORM_RECIPIENT=contact@example.test
# Svix signing secret (whsec_…) for inbound webhooks at /api/v1/webhooks/resend.
# REQUIRED when MAIL_TRANSPORT=resend.
RESEND_WEBHOOK_SECRET=
# Development override - when set, every email is redirected here. Honoured
# under NODE_ENV=development and test only; a production boot refuses it.
MAIL_DEV_REDIRECT_TO=

# ── Sign-up bot protection - Cloudflare Turnstile ─────────────────────────────
# Leave unset in dev and e2e: the widget stays inert and sign-up stays open.
# TURNSTILE_SECRET=

# ── Search-engine submission ────────────────────────────
# IndexNow key: 8 to 128 lower-case hex characters. The storefront serves the
# matching key file; the stepper writes it.
INDEXNOW_KEY=
# Optional. Defaults to the storefront host.
INDEXNOW_HOST=
# Google Search Console API (opt-in):
GSC_SUBMISSION_ENABLED=false
# `sc-domain:<domain>` for a domain property, or `https://<domain>/` for a URL-prefix property.
GSC_SITE_URL=
# Absolute path to the service-account JSON key. Never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=
# Bing Webmaster API (opt-in):
BING_API_KEY=
# The verified site URL; falls back to STOREFRONT_PUBLIC_BASE_URL.
BING_SITE_URL=

# ── Invoice ──────────────────────────────────────────────
# Optional PNG drawn in the invoice header; without it the header carries the
# store name. The stepper writes it from the uploaded logo.
INVOICE_LOGO_PATH=
