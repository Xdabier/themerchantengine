# npm@7+ enforces strict peer-dep resolution by default. Several Analog +
# Angular ecosystem packages declare `peerOptional` deps that older majors
# cannot satisfy (e.g. @analogjs/content@2.4.10 declares `peerOptional sharp@^0.33.5`
# while the project pins sharp@^0.32.0 for the API + seed image-pipeline).
# `peerOptional` is metadata only — the consumer uses the dep best-effort —
# but npm 7+ refuses the install on the conflict. Setting legacy-peer-deps
# restores npm 6 behaviour: peer-dep warnings only, no install failure.
#
# Trade-off: Renovate/Dependabot bumps need manual review on peer-dep
# changes since automated PRs no longer surface peer-dep regressions as
# install errors. Spot-check peer-dep warnings on dep-bump PRs.
legacy-peer-deps=true
