{
  "name": "storefront",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/storefront/src",
  "tags": ["scope:storefront", "type:app"],
  "targets": {
    "build": {
      "executor": "@analogjs/platform:vite",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/storefront/client",
        "configFile": "apps/storefront/vite.config.ts"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production",
          "sourcemap": false
        }
      }
    },
    "serve": {
      "executor": "@analogjs/platform:vite-dev-server",
      "continuous": true,
      "options": {
        "buildTarget": "storefront:build",
        "port": 53300,
        "host": "localhost"
      },
      "configurations": {
        "development": {
          "buildTarget": "storefront:build:development"
        },
        "production": {
          "buildTarget": "storefront:build:production"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-production": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [{ "target": "build", "params": "ignore" }],
      "options": {
        "command": "node dist/apps/storefront/analog/server/index.mjs",
        "cwd": "{workspaceRoot}",
        "env": {
          "PORT": "53311",
          "HOST": "localhost",
          "NITRO_PORT": "53311",
          "NITRO_HOST": "localhost"
        }
      }
    },
    "test": {
      "executor": "@analogjs/platform:vitest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "apps/storefront/vite.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/storefront/src/**/*.{ts,html}"]
      }
    },
    "lighthouse": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx lhci autorun --config=apps/storefront/lighthouserc.cjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "verify-bundle-budgets": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/storefront/tools/verify-bundle-budgets.cjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "verify-ssr-payloads": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/storefront/tools/verify-ssr-payloads-runner.cjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "verify-ssr-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/storefront/tools/verify-ssr-smoke-runner.cjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "verify-font-subsets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/storefront/tools/verify-font-subsets.cjs",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
