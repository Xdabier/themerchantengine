# The storefront's production environment, as the install stepper writes it.
#
# `./setup.sh --profile storefront` (or `both`) writes
# `apps/storefront/.env.production` from its answers, every value quoted and
# mode 0600. This example shows the keys; to change a value, run setup again.

NODE_ENV="production"
PORT="54300"
HOST="0.0.0.0"

# ── Engine ─────────────────────────────────────────────────────────────────
# On one box the storefront reaches the engine over the compose network
# (http://api:53000/api); on its own box it goes out over the public API origin.
STOREFRONT_API_URL="https://api.shop.example/api"
# Public origin used for canonical, og:url, hreflang, JSON-LD URL fields.
STOREFRONT_PUBLIC_BASE_URL="https://shop.example"
# Must equal the engine's STOREFRONT_REVALIDATE_SECRET; a storefront-only box
# is asked for it and the engine box prints it at the end of its install.
STOREFRONT_REVALIDATE_SECRET="<the engine's value>"
# Public; read at build time and passed by the stepper as a build argument.
VITE_TURNSTILE_SITE_KEY="<entered>"

# ── Revalidate dedup store (compose service names) ─────────────────────────
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD="<generated, 64 hex>"

# ── Public API origin, for links the page builds itself ───────────────────
API_URL="https://api.shop.example/api"
