{
  "name": "admin-services-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin-services-e2e/src",
  "tags": ["scope:admin", "type:e2e"],
  "implicitDependencies": ["api", "admin-services"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/.playwright/{projectRoot}"],
      "options": {
        "command": "playwright test -c apps/admin-services-e2e/playwright.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/admin-services-e2e"
      }
    }
  }
}
