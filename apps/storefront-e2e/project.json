{
  "name": "storefront-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storefront-e2e/src",
  "implicitDependencies": ["storefront"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/.playwright/{projectRoot}"],
      "options": {
        "command": "playwright test -c apps/storefront-e2e/playwright.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/storefront-e2e"
      }
    }
  }
}
