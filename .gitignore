# Dependencies
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Build
dist/
build/
*.tsbuildinfo
libs/**/*.js
libs/**/*.js.map
libs/**/*.d.ts
libs/**/*.d.ts.map
!libs/**/*.config.js
!libs/**/.eslintrc.js
!libs/**/.eslintrc.cjs

# Environment
.env
.env.local
.env.*.local
.env.production
apps/*/.env.production

# Production secrets — never commit
deploy/secrets/
*-s3-user-*.txt
*.pem
deploy_key*
.*-creds/
deploy/**/*.pem
deploy/**/*.key

# IndexNow key file (S24.11) — operator drops at apps/storefront/public/<key>.txt;
# never commit. Pattern matches the openssl rand -hex output (lower-case hex,
# 8-128 chars per the IndexNow spec). README at the same path explains the
# operator runbook.
apps/storefront/public/[a-f0-9]*.txt

# Cloud credentials — never commit
# Google Cloud service-account JSON keys (GSC API, etc.)
*service-account*.json
*service_account*.json
*serviceaccount*.json
*gcp-credentials*.json
*google-credentials*.json
*gcp-key*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/
*.lcov

# Logs
logs/
*.log

# Temporary
tmp/
temp/

# Prisma
.env.test.local

.session-runner
.git-notifs

# Nx
.nx/cache
.nx/workspace-data

# Migration scratch
.migration-baseline/

.angular

# Playwright
playwright-report/
playwright/.cache/
test-results/
blob-report/
**/apps/*-e2e/__screenshots__/*-actual-*
**/apps/*-e2e/__screenshots__/*-diff-*

# Lighthouse CI
.lighthouseci/
.lighthouse/

# Playwright live-backend state (storage state, API PID, API log)
apps/admin-e2e/.playwright-state/

# Local review screenshots — phase-by-phase captures for my own eyes,
# not shipped to the repo. Regenerated on each spec run.
.e2e-review/

# Changesets consumes .md files on version; config + README stay tracked
# (handled inline by the package's .gitignore generated by `changeset init`)

# Claude Code personal settings (team settings live in .claude/settings.json)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local-disk asset storage produced by Prisma seeds and the API's private
# files (invoices). Regenerated on every seed run. Never committed.
/uploads/
/uploads-test/
/uploads-private/
/uploads-test-private/


.serena
# Cygwin/msys crash dumps, produced by tooling run under Git Bash on Windows
*.stackdump

# Compiled output that lands beside the e2e sources when tsc is pointed at
# `test/` directly. The runner only ever matches `*.e2e-spec.ts`, so these are
# artifacts: they were committed once, went stale, and kept the previous
# previous fixtures alive months after the sources were migrated.
apps/api/test/*.js
apps/api/test/*.js.map
apps/api/test/*.d.ts
apps/api/test/*.d.ts.map

# Local backups, generated artifacts and captured session state. These can
# hold keys and session cookies, so they never reach the tree.
*.bak-preseed
.env*.bak*
*.graphify-bak
graphify-out/
.dev-logs/
scripts/**/.work/
prod-verify/.state/
*.zip
assets_seed-*
block.txt

# The install stepper (plan E4): its resumable state, its rendered outputs and
# its bundle. The state file holds the operator's answers, the config file the
# store's identity and origins, the bundle is a build artefact.
.setup-state.json
client.config.json
tools/setup/dist/
tools/setup/node_modules/
# An operator's answers document holds secrets; the two committed examples
# hold placeholders.
answers*.json
!tools/setup/answers.*.example.json
!ci/answers.local.json
# Everything the stepper renders or copies under deploy/<profile>/: the
# compose file, the vhosts, the license, the logo, the service-account key,
# the IndexNow key file, the timer units, the local uploads.
deploy/engine/
deploy/storefront/
deploy/local/

# Test license public key (plan E1.5). The fixture script discards the private half.
!test/fixtures/license/public.pem
.e2e-full.txt
.e2e-one.txt

# Screenshots the admin SEO journey writes for a reviewer's eyes; never a baseline.
.e2e-seo/

# Python bytecode from scripts/llm-metrics
__pycache__/

# Nitro build output (Analog storefront); ESLint already ignores it per lane
.nitro/
