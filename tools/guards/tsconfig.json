{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "jest.config.ts"],
  "exclude": ["node_modules", "src/__fixtures__/**"]
}
