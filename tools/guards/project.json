{
  "name": "guards",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/guards/src",
  "projectType": "application",
  "tags": ["scope:tools", "type:app"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/tools/guards"],
      "options": {
        "command": "jest -c tools/guards/jest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/guards/tsconfig.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
